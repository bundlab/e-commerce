<DashboardScreen>:

    MDBoxLayout:
        orientation: "vertical"

        # =========================
        # TOP APP BAR
        # =========================
        MDTopAppBar:
            title: "eShop"
            elevation: 4

        # =========================
        # SEARCH BAR
        # =========================
        MDBoxLayout:
            size_hint_y: None
            height: "70dp"
            padding: "10dp"

            MDTextField:
                hint_text: "Search products..."
                mode: "rectangle"

        # =========================
        # CATEGORY SECTION
        # =========================
        ScrollView:
            size_hint_y: None
            height: "60dp"
            do_scroll_x: True
            do_scroll_y: False

            MDBoxLayout:
                adaptive_width: True
                spacing: "10dp"
                padding: "10dp"

                MDChip:
                    text: "Phones"

                MDChip:
                    text: "Fashion"

                MDChip:
                    text: "Electronics"

                MDChip:
                    text: "Home"

                MDChip:
                    text: "Gaming"

        # =========================
        # PRODUCT GRID
        # =========================
        ScrollView:

            MDGridLayout:
                id: product_grid
                cols: 2
                spacing: "12dp"
                padding: "12dp"
                adaptive_height: True
                size_hint_y: None

                # =====================
                # PRODUCT CARD 1
                # =====================
                MDCard:
                    orientation: "vertical"
                    size_hint_y: None
                    height: "320dp"
                    padding: "8dp"
                    radius: [20]
                    elevation: 4

                    AsyncImage:
                        source: "assets/images/iphone.png"
                        allow_stretch: True
                        keep_ratio: True
                        size_hint_y: 0.65

                    MDLabel:
                        text: "iPhone 15 Pro"
                        halign: "center"
                        bold: True
                        size_hint_y: None
                        height: "30dp"

                    MDLabel:
                        text: "₦999"
                        halign: "center"
                        theme_text_color: "Primary"
                        size_hint_y: None
                        height: "30dp"

                    Widget:

                    MDRaisedButton:
                        text: "Add to Cart"
                        size_hint_y: None
                        height: "45dp"
                        pos_hint: {"center_x": 0.5}

                # =====================
                # PRODUCT CARD 2
                # =====================
                MDCard:
                    orientation: "vertical"
                    size_hint_y: None
                    height: "320dp"
                    padding: "8dp"
                    radius: [20]
                    elevation: 4

                    AsyncImage:
                        source: "assets/images/nike.png"
                        allow_stretch: True
                        keep_ratio: True
                        size_hint_y: 0.65

                    MDLabel:
                        text: "Nike Shoes"
                        halign: "center"
                        bold: True
                        size_hint_y: None
                        height: "30dp"

                    MDLabel:
                        text: "₦120"
                        halign: "center"
                        theme_text_color: "Primary"
                        size_hint_y: None
                        height: "30dp"

                    Widget:

                    MDRaisedButton:
                        text: "Add to Cart"
                        size_hint_y: None
                        height: "45dp"
                        pos_hint: {"center_x": 0.5}

                # =====================
                # PRODUCT CARD 3
                # =====================
                MDCard:
                    orientation: "vertical"
                    size_hint_y: None
                    height: "320dp"
                    padding: "8dp"
                    radius: [20]
                    elevation: 4

                    AsyncImage:
                        source: "assets/images/tv.png"
                        allow_stretch: True
                        keep_ratio: True
                        size_hint_y: 0.65

                    MDLabel:
                        text: "Samsung Smart TV"
                        halign: "center"
                        bold: True
                        size_hint_y: None
                        height: "30dp"

                    MDLabel:
                        text: "₦450"
                        halign: "center"
                        theme_text_color: "Primary"
                        size_hint_y: None
                        height: "30dp"

                    Widget:

                    MDRaisedButton:
                        text: "Add to Cart"
                        size_hint_y: None
                        height: "45dp"
                        pos_hint: {"center_x": 0.5}

                # =====================
                # PRODUCT CARD 4
                # =====================
                MDCard:
                    orientation: "vertical"
                    size_hint_y: None
                    height: "320dp"
                    padding: "8dp"
                    radius: [20]
                    elevation: 4

                    AsyncImage:
                        source: "assets/images/laptop.png"
                        allow_stretch: True
                        keep_ratio: True
                        size_hint_y: 0.65

                    MDLabel:
                        text: "Gaming Laptop"
                        halign: "center"
                        bold: True
                        size_hint_y: None
                        height: "30dp"

                    MDLabel:
                        text: "₦1500"
                        halign: "center"
                        theme_text_color: "Primary"
                        size_hint_y: None
                        height: "30dp"

                    Widget:

                    MDRaisedButton:
                        text: "Add to Cart"
                        size_hint_y: None
                        height: "45dp"
                        pos_hint: {"center_x": 0.5}

        # =========================
        # BOTTOM NAVIGATION
        # =========================
        MDBottomNavigation:
            panel_color: .95, .95, .95, 1

            MDBottomNavigationItem:
                name: "home"
                text: "Home"
                icon: "home"

                MDLabel:
                    text: "Home"
                    halign: "center"

            MDBottomNavigationItem:
                name: "cart"
                text: "Cart"
                icon: "cart"

                MDLabel:
                    text: "Cart"
                    halign: "center"

            MDBottomNavigationItem:
                name: "profile"
                text: "Profile"
                icon: "account"

                MDLabel:
                    text: "Profile"
                    halign: "center"

            MDBottomNavigationItem:
                name: "settings"
                text: "Settings"
                icon: "cog"

                MDLabel:
                    text: "Settings"
                    halign: "center"